#id các task bỏ qua, không cần quan tâm nếu không hiểu
SKIP_TASKS =[""]
BASE_URL="https://api0.herewallet.app/api/v1"
ENABLE_DEBUG=true

#Nếu không đủ số dư near sẽ claim off chain, không muốn claim onchain chỉ muốn claim off chain thì set: false
AUTO_CLAIM_ONCHAIN=true

#use proxy or not
USE_PROXY=true

#Thời gian nghỉ (phut)
TIME_SLEEP=10

#Thời gian chờ giữa các yêu cầu API 
DELAY_BETWEEN_REQUESTS=[5,15]

#Thời gian chờ trước khi chạy bot
DELAY_START_BOT=[1,5]

#Số luồng
MAX_THEADS=10

#số luồng dành cho bản không dùng proxy
MAX_THEADS_NO_PROXY=1
